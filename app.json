{
  "expo": {
    "name": "MI Banda",
    "slug": "MaestroTareas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/LogoMB.png",
    "scheme": "mibanda",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D0F",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.pacogomezlr.mibanda",
      "adaptiveIcon": {
        "backgroundColor": "#01080B",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D0F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "MI Banda usa tus fotos para elegir el logo de la banda.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "99c936cc-f92f-4c3e-ae56-34990372959f"
      }
    },
    "owner": "txepamusic"
  }
}
